{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/dashboard.py": {
      "includeFiles": "{docs/Entrega_3/Base_dados_SMART_tratada.xlsx,docs/Entrega_5/MVP/smartcoleta/**,public/static/**}",
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/dashboard"
    },
    {
      "source": "/index.html",
      "destination": "/api/dashboard"
    }
  ]
}
